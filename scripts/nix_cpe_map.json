{
 "schema": "velstra-nix-cpe-map/1",
 "description": "Nix package name (as syft's nix cataloger reports it) -> NVD CPE vendor/product. syft emits cpe:2.3:a:<name>:<name> for every Nix package, which grype matches for almost nothing (audit 8b6181 IMG-05). Shared with the enterprise pipeline: load with any JSON parser, never edit a copy.",
 "critical": [
  "linux-kernel",
  "glibc",
  "openssh",
  "openssl",
  "curl",
  "systemd",
  "sudo",
  "dnsmasq",
  "strongswan"
 ],
 "version-rules": {
  "as-is": "the Nix version, unchanged (default)",
  "strip-nix-revision": "drop a trailing -<digits> Nix release-branch revision (glibc 2.42-100 -> 2.42)"
 },
 "kernel": {
  "note": "The kernel is never mapped from a Nix name: it must come from syft's linux-kernel cataloger (cpe:2.3:o:linux:linux_kernel:<version>), read from the bzImage. Nix packages named linux / linux-headers are not matched."
 },
 "first-party": [
  "sentinel",
  "sentinel-ui",
  "velstra",
  "velstra-ebpf",
  "velstra-wren",
  "wren"
 ],
 "first-party-note": "Velstra's own binaries: their dependencies are scanned through cargo-auditable data; a guessed CPE only matches unrelated products of the same name (the audit's two false 'wren' Highs).",
