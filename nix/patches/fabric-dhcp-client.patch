+        return false;
+    }
+    let Some(params) = fib_scratch() else {
+        return false;
+    };
+    unsafe {
+        (*params).family = AF_INET;
+        (*params).l4_protocol = ip_proto::UDP;
+        (*params).sport = 67u16.to_be();
+        (*params).dport = 68u16.to_be();
+        (*params).__bindgen_anon_1.tot_len = length as u16;
+        (*params).ifindex = ifindex;
