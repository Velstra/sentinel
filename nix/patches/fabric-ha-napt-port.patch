+        if let Some(state) = unsafe { CONNTRACK.get(&key) }.copied() {
+            if napt_binding_matches(&state, origin, flow.src_port)
+                && !state.expired(flow.proto, now, timeouts)
+            {
+                return true;
+            }
+        }
+        false
+    })
